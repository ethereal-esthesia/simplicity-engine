{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ios-iphone-simulator-debug",
      "displayName": "iOS iPhone Simulator Debug",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios-iphone-simulator-debug",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0"
      }
    },
    {
      "name": "ios-iphone-simulator-release",
      "displayName": "iOS iPhone Simulator Release",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios-iphone-simulator-release",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ios-iphone-simulator-debug",
      "configurePreset": "ios-iphone-simulator-debug",
      "targets": [
        "hello_pixel"
      ],
      "configuration": "Debug"
    },
    {
      "name": "ios-iphone-simulator-release",
      "configurePreset": "ios-iphone-simulator-release",
      "targets": [
        "hello_pixel"
      ],
      "configuration": "Release"
    }
  ]
}
