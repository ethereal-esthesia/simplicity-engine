{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simplicity Engine",
  "version": "0.1.0",
  "identifier": "dev.simplicityengine.desktop",
  "build": {
    "beforeDevCommand": "npm run build:diagram",
    "beforeBuildCommand": "npm run build:diagram",
    "frontendDist": "../web"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Simplicity Engine",
        "width": 88,
        "height": 88,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
