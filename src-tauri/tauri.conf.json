{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simplicity Engine",
  "version": "0.1.0",
  "identifier": "dev.simplicityengine.desktop",
  "build": {
    "beforeDevCommand": "npm run build:wasm",
    "beforeBuildCommand": "npm run build:wasm",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Simplicity Engine - Hello Pixel",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
